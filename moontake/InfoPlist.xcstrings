          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "moontake を使用する際に写真ライブラリへのアクセスを許可して、写真を直接写真ライブラリに保存する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à biblioteca de fotos para salvar fotos diretamente na sua biblioteca de fotos ao usar moontake"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à biblioteca de fotos para salvar fotos diretamente na sua biblioteca de fotos ao usar moontake"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к фотобиблиотеке для прямого сохранения фотографий в вашу фотобиблиотеку при использовании moontake"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до фотобібліотеки для прямого збереження фотографій у вашу фотобібліотеку під час використання moontake"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问照片库，在使用 moontake 时直接保存照片到您的照片库"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取照片庫，以便在使用 moontake 時將照片直接儲存到您的照片庫"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取照片庫，以便在使用 moontake 時將照片直接儲存到您的照片庫"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى مكتبة الصور لحفظ الصور مباشرةً في مكتبة الصور عند استخدام moontake"
          }
        }
      }
