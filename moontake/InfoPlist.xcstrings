    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf die Kamera, um Fotos mit moontake aufzunehmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to the camera to take photos with moontake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la cámara para tomar fotos con moontake"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la cámara para tomar fotos con moontake"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès à l'appareil photo pour prendre des photos avec moontake"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "moontake で写真を撮るためにカメラへのアクセスを許可する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à câmera para tirar fotos com moontake"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à câmera para tirar fotos com moontake"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к камере для съемки фотографий с moontake"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до камери для зйомки фотографій з moontake"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问相机以使用 moontake 拍照"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取相機，以便使用 moontake 拍照"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取相機，以便使用 moontake 拍照"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الكاميرا لالتقاط الصور باستخدام moontake"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf den Standort, um GPS-Koordinaten in die Metadaten des Fotos einzubetten, damit du sie später auf einer Karte sehen kannst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to the location to embed GPS coordinates into the photo's metadata, so you can see it on a map later"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la ubicación para incrustar coordenadas GPS en los metadatos de la foto, para que puedas verlas en un mapa más tarde"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la ubicación para incrustar coordenadas GPS en los metadatos de la foto, para que puedas verlas en un mapa más tarde"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès à l'emplacement pour intégrer les coordonnées GPS dans les métadonnées de la photo, afin de les voir sur une carte plus tard"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で地図上で確認できるように、写真のメタデータにGPS座標を埋め込むために位置情報へのアクセスを許可する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à localização para incorporar coordenadas GPS nos metadados da foto, para que possa vê-las num mapa mais tarde"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à localização para incorporar coordenadas GPS nos metadados da foto, para que possa vê-las num mapa mais tarde"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к местоположению для встраивания GPS-координат в метаданные фотографии, чтобы вы могли увидеть их на карте позже"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до місця розташування для вбудовування GPS-координат в метадані фотографії, щоб ви могли побачити їх на мапі пізніше"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问位置信息，将 GPS 坐标嵌入照片元数据，以便稍后在地图上查看"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取位置資訊，將 GPS 座標嵌入照片的元資料，以便稍後在地圖上查看"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取位置資訊，將 GPS 座標嵌入照片的元資料，以便稍後在地圖上查看"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع لتضمين إحداثيات GPS في البيانات الوصفية للصورة حتى تتمكن من رؤيتها على الخريطة لاحقًا"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf die Fotobibliothek, um Fotos direkt in deiner Fotobibliothek zu speichern, wenn du moontake verwendest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to photo library to save photos to your photo library directly when using moontake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la biblioteca de fotos para guardar fotos directamente en tu biblioteca de fotos al usar moontake"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
