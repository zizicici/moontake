    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf die Kamera, um Fotos mit moontake aufzunehmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to the camera to take photos with moontake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la cámara para tomar fotos con moontake"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la cámara para tomar fotos con moontake"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès à l'appareil photo pour prendre des photos avec moontake"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "moontake で写真を撮るためにカメラへのアクセスを許可する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à câmera para tirar fotos com moontake"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à câmera para tirar fotos com moontake"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к камере для съемки фотографий с moontake"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до камери для зйомки фотографій з moontake"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问相机以使用 moontake 拍照"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取相機，以便使用 moontake 拍照"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取相機，以便使用 moontake 拍照"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الكاميرا لالتقاط الصور باستخدام moontake"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standortzugriff, um den Mond zu finden und bei aktivierter Option GPS-Koordinaten zu Fotos hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location access to find the Moon and, when enabled, add GPS coordinates to your photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la ubicación para encontrar la Luna y, si activas la opción, añadir coordenadas GPS a tus fotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la ubicación para encontrar la Luna y, si activas la opción, añadir coordenadas GPS a tus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez la localisation pour trouver la Lune et, si l’option est activée, ajouter les coordonnées GPS aux photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月を探すために位置情報を使用します。写真の位置記録を有効にした場合は、GPS座標も写真に保存します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a localização para encontrar a Lua e, quando ativado, adicionar coordenadas GPS às fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a localização para encontrar a Lua e, quando ativado, adicionar coordenadas GPS às fotografias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите геолокацию для поиска Луны и, если включена эта функция, сохранения GPS-координат в фотографиях."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте геолокацію для пошуку Місяця та, якщо ввімкнено цю функцію, збереження GPS-координат у фотографіях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问位置以寻找月亮，并在开启照片位置记录时将 GPS 坐标保存到照片中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取位置以尋找月亮，並在開啟照片位置記錄時將 GPS 座標儲存至照片。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取位置以尋找月亮，並在開啟照片位置記錄時將 GPS 座標儲存至照片。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع للعثور على القمر وإضافة إحداثيات GPS إلى الصور عند تفعيل الخيار."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use device motion and the compass to guide your camera toward the Moon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用设备姿态和指南针信息，引导相机朝向月亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用裝置姿態和指南針資訊，引導相機朝向月亮。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Gerätebewegung und Kompass, um die Kamera zum Mond auszurichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les mouvements de l’appareil et la boussole pour orienter la caméra vers la Lune."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el movimiento del dispositivo y la brújula para orientar la cámara hacia la Luna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の姿勢とコンパスを使用して、カメラを月の方向へ案内します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o movimento do dispositivo e a bússola para orientar a câmara para a Lua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o movimento do dispositivo e a bússola para orientar a câmera para a Lua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте движение устройства и компас для наведения камеры на Луну."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте рух пристрою й компас для наведення камери на Місяць."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم حركة الجهاز والبوصلة لتوجيه الكاميرا نحو القمر."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用裝置姿態和指南針資訊，引導相機朝向月亮。"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el movimiento del dispositivo y la brújula para orientar la cámara hacia la Luna."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf die Fotobibliothek, um Fotos direkt in deiner Fotobibliothek zu speichern, wenn du moontake verwendest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to photo library to save photos to your photo library directly when using moontake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la biblioteca de fotos para guardar fotos directamente en tu biblioteca de fotos al usar moontake"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acceso a la biblioteca de fotos para guardar fotos directamente en tu biblioteca de fotos al usar moontake"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès à la photothèque pour enregistrer directement les photos dans votre photothèque lors de l'utilisation de moontake"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "moontake を使用する際に写真ライブラリへのアクセスを許可して、写真を直接写真ライブラリに保存する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à biblioteca de fotos para salvar fotos diretamente na sua biblioteca de fotos ao usar moontake"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à biblioteca de fotos para salvar fotos diretamente na sua biblioteca de fotos ao usar moontake"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к фотобиблиотеке для прямого сохранения фотографий в вашу фотобиблиотеку при использовании moontake"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до фотобібліотеки для прямого збереження фотографій у вашу фотобібліотеку під час використання moontake"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问照片库，在使用 moontake 时直接保存照片到您的照片库"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取照片庫，以便在使用 moontake 時將照片直接儲存到您的照片庫"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取照片庫，以便在使用 moontake 時將照片直接儲存到您的照片庫"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى مكتبة الصور لحفظ الصور مباشرةً في مكتبة الصور عند استخدام moontake"
          }
