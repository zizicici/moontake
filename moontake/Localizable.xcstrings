    "detail.alert.delete.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto wird aus der App gelöscht, aber Fotos, die in der Systembibliothek gespeichert sind, werden nicht gelöscht."
