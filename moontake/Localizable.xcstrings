    "Pro users can unlock all watermarks and have the ability to save the original images." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-Benutzer können alle Wasserzeichen freischalten und die Originalbilder speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios Pro pueden desbloquear todas las marcas de agua y tienen la capacidad de guardar las imágenes originales."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios Pro pueden desbloquear todas las marcas de agua y tienen la capacidad de guardar las imágenes originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisateurs Pro peuvent déverrouiller tous les filigranes et ont la possibilité de sauvegarder les images originales."
