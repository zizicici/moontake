    "settings.app_album.footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم هذا الخيار فقط في الصور الجديدة التي تلتقطها بعد الآن.\nإيقافه لن يحذف الصور الموجودة بالفعل في ألبوم التطبيق، كما أنه لا يؤثر على إعدادات الحفظ في مكتبة الصور بالنظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung gilt nur für neue Fotos, die Sie ab jetzt aufnehmen.\nWenn Sie sie deaktivieren, werden bereits vorhandene Fotos im App-Album nicht gelöscht, und die Einstellungen zum Speichern in der System-Fotomediathek bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only affects new photos you take from now on.\nTurning it off won't remove photos already in the app album, and it doesn't change Photo Library save settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo afecta a las fotos nuevas que tomes a partir de ahora.\nDesactivarlo no eliminará las fotos que ya están en el álbum de la app y tampoco cambiará la configuración de guardado en la biblioteca del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo afecta a las fotos nuevas que tomes a partir de ahora.\nDesactivarlo no eliminará las fotos que ya están en el álbum de la app y tampoco cambiará la configuración de guardado en la biblioteca del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne concerne que les nouvelles photos que vous prendrez à partir de maintenant.\nLe désactiver ne supprimera pas les photos déjà présentes dans l’album de l’app et ne modifiera pas les réglages d’enregistrement dans la photothèque système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定は、これ以降に新しく撮影する写真にのみ適用されます。\nオフにしても、すでにアプリ内アルバムにある写真は削除されず、システムの写真ライブラリへの保存設定にも影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso afeta apenas as novas fotos que você tirar a partir de agora.\nDesativar não removerá as fotos que já estão no álbum do app e também não mudará as configurações de salvamento na biblioteca do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto afeta apenas as novas fotografias que tirar a partir de agora.\nDesativar não irá remover as fotografias já existentes no álbum da app e também não altera as definições de gravação na fototeca do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот параметр влияет только на новые фотографии, которые вы сделаете с этого момента.\nОтключение не удалит фотографии, уже сохраненные в альбоме приложения, и не изменит настройки сохранения в системную фотобиблиотеку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це впливає лише на нові фотографії, які ви зробите відтепер.\nВимкнення не видалить фотографії, що вже є в альбомі застосунку, і не змінить налаштування збереження до системної фотобібліотеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个选项只影响你之后新拍的照片。\n关闭后不会删除 App 内相册中已有的照片，也不会改变保存到系统相册的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個選項只會影響你之後新拍的照片。\n關閉後不會刪除 App 內相簿中已有的照片，也不會改變保存到系統相簿的設定。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個選項只會影響你之後新拍的照片。\n關閉後不會刪除 App 內相簿中已有的照片，也不會改變保存到系統相簿的設定。"
          }
        }
      }
    },
