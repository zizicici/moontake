      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع في الإعدادات. لن يؤدي ذلك إلى تفعيل تسجيل GPS في صورك."
