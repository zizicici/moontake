    "atlas.feature.3683.naming" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير Nectaris إلى الرحيق، شراب الآلهة في الأدب الكلاسيكي. وضع ريتشيولي «بحر الرحيق» على خريطة عام 1651. وينضم إلى الصفاء والهدوء في مجموعة شرقية من الأسماء الجميلة، حاملًا صورة من الأساطير إلى عالم آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris bezieht sich auf Nektar, den Trank der Götter in der antiken Literatur. Riccioli setzte dieses „Meer des Nektars“ auf die Karte von 1651. Zusammen mit Heiterkeit und Ruhe gehört es zu einer Gruppe angenehmer Namen im Osten, die ein Bild aus der Mythologie auf eine andere Welt überträgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris refers to nectar, the drink of the gods in classical literature. Riccioli placed this “Sea of Nectar” on the 1651 map. It joins Serenity and Tranquility in an eastern group of pleasing names, carrying an image from mythology onto another world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris alude al néctar, la bebida de los dioses en la literatura clásica. Riccioli incluyó este «mar del Néctar» en su mapa de 1651. Se une a Serenidad y Tranquilidad en un grupo oriental de nombres agradables, trasladando una imagen mitológica a otro mundo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris alude al néctar, la bebida de los dioses en la literatura clásica. Riccioli incluyó este «mar del Néctar» en su mapa de 1651. Se une a Serenidad y Tranquilidad en un grupo oriental de nombres agradables, trasladando una imagen mitológica a otro mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris désigne le nectar, la boisson des dieux dans la littérature antique. Riccioli a placé cette « mer du Nectar » sur sa carte de 1651. Elle rejoint la Sérénité et la Tranquillité dans un groupe de noms plaisants à l’est, transportant une image mythologique sur un autre monde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectarisは、古典文学に登場する神々の飲み物ネクタルを指します。リッチョーリは1651年の月面図に、この「神酒の海」を載せました。晴れの海や静かの海とともに、東部の好ましい響きを持つ地名の一つで、神話のイメージが月に持ち込まれています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris se refere ao néctar, a bebida dos deuses na literatura clássica. Riccioli incluiu esse “Mar do Néctar” no mapa de 1651. Ele se junta à Serenidade e à Tranquilidade em um grupo de nomes agradáveis a leste, levando uma imagem da mitologia a outro mundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris refere-se ao néctar, a bebida dos deuses na literatura clássica. Riccioli incluiu este “Mar do Néctar” no mapa de 1651. O nome junta-se à Serenidade e à Tranquilidade num grupo de nomes agradáveis a leste, levando uma imagem da mitologia a outro mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris отсылает к нектару, напитку богов в античной литературе. Риччоли поместил «Море Нектара» на карту 1651 года. Вместе с Морями Ясности и Спокойствия оно входит в восточную группу благозвучных имён, перенося мифологический образ на другой мир."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris відсилає до нектару, напою богів в античній літературі. Річчолі помістив «Море Нектару» на карту 1651 року. Разом із Морями Ясності та Спокою воно входить до східної групи приємних за змістом назв, переносячи міфологічний образ на інший світ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris指古典文学中众神饮用的甘露。里乔利在1651年月图上标出了这片“甘露之海”。它与澄海、静海一起，构成东部一组寓意美好的名称，将神话中的意象带到了另一个世界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris指古典文學中眾神飲用的甘露。里喬利在1651年月圖上標出了這片「甘露之海」。它與澄海、靜海一起，構成東部一組寓意美好的名稱，將神話中的意象帶到了另一個世界。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nectaris指古典文學中眾神飲用的甘露。里喬利在1651年月圖上標出了這片「甘露之海」。它與澄海、靜海一起，構成東部一組寓意美好的名稱，將神話中的意象帶到了另一個世界。"
          }
        }
      }
    },
    "atlas.feature.3683.observation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جنوب بحر الهدوء، يبدو بحر الرحيق بقعة داكنة أصغر ومستديرة، تحيط بها مرتفعات ساطعة كثيرة الفوهات. يساعد شكله المتماسك على تمييزه عن البحار الأكبر المجاورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Südlich von Tranquillitatis ist Nectaris eine kleinere, rundliche dunkle Fläche, umrahmt von hellen Hochländern mit vielen Kratern. Die kompakte Form hilft, es von den größeren Nachbarn zu unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "South of Tranquillitatis, Nectaris is a smaller, rounded dark patch framed by bright, heavily cratered highlands. Its compact outline helps distinguish it from its larger neighbors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al sur de Tranquillitatis, Nectaris es una mancha oscura más pequeña y redondeada, enmarcada por tierras altas brillantes y llenas de cráteres. Su contorno compacto permite distinguirlo de sus vecinos de mayor tamaño."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al sur de Tranquillitatis, Nectaris es una mancha oscura más pequeña y redondeada, enmarcada por tierras altas brillantes y llenas de cráteres. Su contorno compacto permite distinguirlo de sus vecinos de mayor tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au sud de Tranquillitatis, Nectaris est une petite tache sombre arrondie, encadrée de hauts plateaux clairs criblés de cratères. Ses contours compacts aident à la distinguer de ses grandes voisines."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かの海の南にある神酒の海は、比較的小さく丸い暗部です。周囲を明るくクレーターの多い高地が囲み、まとまった輪郭が近隣の大きな海との違いになっています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao sul do Mar da Tranquilidade, o Mar do Néctar é uma mancha escura menor e arredondada, cercada por terras altas claras e repletas de crateras. Seu contorno compacto ajuda a distingui-lo dos vizinhos maiores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao sul do Mar da Tranquilidade, o Mar do Néctar é uma mancha escura menor e arredondada, cercada por terras altas claras e repletas de crateras. O seu contorno compacto ajuda a distingui-lo dos vizinhos maiores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К югу от Моря Спокойствия находится небольшое округлое тёмное Море Нектара, окружённое светлыми, густо покрытыми кратерами возвышенностями. Компактные очертания отличают его от более крупных соседей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На південь від Моря Спокою Море Нектару утворює меншу округлу темну пляму, оточену світлими височинами, густо вкритими кратерами. Компактні обриси допомагають відрізнити його від більших сусідів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "酒海位于静海南方，是一块较小的圆形暗区，外围是明亮、布满撞击坑的高地。紧凑的轮廓有助于把它与更大的邻近月海区分开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "酒海位於靜海南方，是一塊較小的圓形暗區，外圍是明亮、佈滿撞擊坑的高地。緊湊的輪廓有助於把它與更大的鄰近月海區分開。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "酒海位於靜海南方，是一塊較小的圓形暗區，外圍是明亮、佈滿撞擊坑的高地。緊湊的輪廓有助於把它與更大的鄰近月海區分開。"
          }
        }
      }
    },
    "atlas.feature.3683.story" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تشغل البقعة الداكنة المرئية سوى المركز العميق لحوض الرحيق. وإلى الجنوب الغربي بعيدًا عنها، يرسم جرف ألتاي المقوّس جزءًا من بنية حلقية أكبر بكثير. ينتمي السهل الداكن والجرف البعيد إلى الحوض نفسه، لذا لا تُظهر حدود البحر كامل حجم الاصطدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die sichtbare dunkle Fläche nimmt nur den tiefen Mittelteil des Nectaris-Beckens ein. Weiter südwestlich zeichnet der gebogene Altai-Steilhang einen Teil seiner viel größeren Ringstruktur nach. Die dunkle Ebene und der entfernte Steilhang gehören zum selben Becken. Der Umriss des Mondmeers lässt den Einschlag daher kleiner erscheinen, als er war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The visible dark patch occupies only the deep center of the Nectaris basin. Farther southwest, the curved Altai scarp traces part of its much larger ring structure. The dark plain and the distant cliff belong to the same basin, so the mare’s outline understates the scale of the impact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mancha oscura visible ocupa solo el centro profundo de la cuenca de Nectaris. Más al suroeste, el escarpe curvo de Altái dibuja parte de su estructura anular, mucho más grande. La llanura oscura y el lejano acantilado pertenecen a la misma cuenca: el contorno del mar hace parecer menor la magnitud del impacto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mancha oscura visible ocupa solo el centro profundo de la cuenca de Nectaris. Más al suroeste, el escarpe curvo de Altái dibuja parte de su estructura anular, mucho más grande. La llanura oscura y el lejano acantilado pertenecen a la misma cuenca: el contorno del mar hace parecer menor la magnitud del impacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tache sombre visible n’occupe que le centre profond du bassin de Nectaris. Plus au sud-ouest, l’escarpement courbe de l’Altaï dessine une partie de sa structure annulaire, bien plus vaste. La plaine sombre et la falaise lointaine appartiennent au même bassin : le contour de la mer sous-estime donc l’ampleur de l’impact."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見えている暗部は、神酒の海盆地の深い中央部分にすぎません。さらに南西のアルタイ断崖は、盆地を囲むはるかに大きな環状構造の一部です。暗い平原と遠くの崖は同じ盆地に属しており、衝突の規模は海の輪郭から受ける印象よりずっと大きかったのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mancha escura visível ocupa apenas o centro profundo da bacia do Mar do Néctar. Mais a sudoeste, a escarpa curva de Altai delineia parte de uma estrutura em anel muito maior. A planície escura e o penhasco distante pertencem à mesma bacia; por isso, o contorno do mar dá uma ideia menor do que foi a escala do impacto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mancha escura visível ocupa apenas o centro profundo da bacia do Mar do Néctar. Mais a sudoeste, a escarpa curva de Altai delineia parte de uma estrutura em anel muito maior. A planície escura e a escarpa distante pertencem à mesma bacia; por isso, o contorno do mar não revela a verdadeira dimensão do impacto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видимое тёмное пятно занимает лишь глубокий центр бассейна Моря Нектара. Дальше к юго-западу дуга уступа Алтай отмечает часть гораздо более крупной кольцевой структуры. Тёмная равнина и далёкий обрыв принадлежат одному бассейну, поэтому очертания моря не передают полного масштаба удара."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видима темна пляма займає лише глибокий центр басейну Моря Нектару. Далі на південний захід дуга уступу Алтай окреслює частину значно більшої кільцевої структури. Темна рівнина й віддалене урвище належать до одного басейну, тож обриси моря применшують справжній масштаб удару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可见的暗区只占据酒海盆地深处的中心。更远的西南方，弧形的阿尔泰峭壁勾勒出规模大得多的盆地环形构造的一部分。暗色平原与远处的陡崖属于同一盆地，因此仅看月海轮廓，会低估那次撞击的规模。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可見的暗區只佔據酒海盆地深處的中心。更遠的西南方，弧形的阿爾泰峭壁勾勒出規模大得多的盆地環形構造的一部分。暗色平原與遠處的陡崖屬於同一盆地，因此僅看月海輪廓，會低估那次撞擊的規模。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可見的暗區只佔據酒海盆地深處的中心。更遠的西南方，弧形的阿爾泰峭壁勾勒出規模大得多的盆地環形構造的一部分。暗色平原與遠處的陡崖屬於同一盆地，因此僅看月海輪廓，會低估那次撞擊的規模。"
          }
        }
      }
    },
