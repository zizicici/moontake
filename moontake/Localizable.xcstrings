    "hint.promotion" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمستخدمين المجانيين عرض أحدث 12 صورة، بينما يمكن لمستخدمي Pro عرض جميع الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Benutzer können die 12 neuesten Fotos anzeigen, während Pro-Benutzer alle Fotos anzeigen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
