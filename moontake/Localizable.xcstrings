    "atlas.feature.3694.naming" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعني Mare Vaporum «بحر الأبخرة». نشر جيوفاني باتيستا ريتشيولي الاسم على خريطته القمرية عام 1651، التي رسمها فرانشيسكو غريمالدي. وينتمي إلى مفردات الطقس نفسها التي نجدها في بحري السحاب والأمطار. بقي الاسم من زمن رسم فيه الفلكيون خرائط القمر بالتلسكوبات، قبل أن تفحص المركبات الفضائية سطحه عن قرب بقرون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum bedeutet „Meer der Dämpfe“. Giovanni Battista Riccioli veröffentlichte den Namen 1651 auf seiner von Francesco Grimaldi gezeichneten Mondkarte. Er gehört zu denselben Wetterbegriffen wie die Meere der Wolken und des Regens. Der Name stammt aus einer Zeit, in der Astronomen den Mond mit Teleskopen kartierten, Jahrhunderte bevor Raumsonden seine Oberfläche aus der Nähe untersuchen konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum means “Sea of Vapors.” Giovanni Battista Riccioli published the name on his 1651 lunar map, drawn by Francesco Grimaldi. It belongs to the same weather vocabulary as the seas of clouds and rain. The name survives from an era when astronomers mapped the Moon through telescopes, centuries before spacecraft could examine the surface closely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum significa «mar de los Vapores». Giovanni Battista Riccioli publicó el nombre en su mapa lunar de 1651, dibujado por Francesco Grimaldi. Pertenece al mismo vocabulario meteorológico que las nubes y las lluvias. Procede de una época en la que los astrónomos cartografiaban la Luna con telescopios, siglos antes de que las sondas pudieran examinar la superficie de cerca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum significa «mar de los Vapores». Giovanni Battista Riccioli publicó el nombre en su mapa lunar de 1651, dibujado por Francesco Grimaldi. Pertenece al mismo vocabulario meteorológico que las nubes y las lluvias. Procede de una época en la que los astrónomos cartografiaban la Luna con telescopios, siglos antes de que las sondas pudieran examinar la superficie de cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum signifie « mer des Vapeurs ». Giovanni Battista Riccioli a publié ce nom sur sa carte lunaire de 1651, dessinée par Francesco Grimaldi. Il appartient au même vocabulaire météorologique que les mers de nuages et de pluie. Ce nom vient d’une époque où les astronomes cartographiaient la Lune au télescope, des siècles avant que les sondes puissent examiner le sol de près."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporumは「蒸気の海」という意味です。ジョヴァンニ バッティスタ リッチョーリが1651年、フランチェスコ グリマルディの描いた月面図で発表しました。雲や雨の海と同じ天候の語彙に属します。探査機が月面を間近に調べる何世紀も前、望遠鏡で月の地図を作っていた時代の名前です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum significa “Mar dos Vapores”. Giovanni Battista Riccioli publicou o nome em seu mapa lunar de 1651, desenhado por Francesco Grimaldi. Ele pertence ao mesmo vocabulário atmosférico dos mares de nuvens e de chuvas. O nome sobrevive de uma época em que astrônomos mapeavam a Lua com telescópios, séculos antes de sondas poderem examinar a superfície de perto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum significa “Mar dos Vapores”. Giovanni Battista Riccioli publicou o nome no seu mapa lunar de 1651, desenhado por Francesco Grimaldi. Ele pertence ao mesmo vocabulário atmosférico dos mares de nuvens e de chuvas. O nome sobrevive de uma época em que astrónomos mapeavam a Lua com telescópios, séculos antes de sondas poderem examinar a superfície de perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum означает «Море Паров». Джованни Баттиста Риччоли опубликовал название в 1651 году на лунной карте Франческо Гримальди. Оно относится к той же погодной лексике, что и моря облаков и дождей. Имя дошло до нас со времени, когда астрономы составляли карты по телескопическим наблюдениям, за столетия до подробных исследований поверхности космическими аппаратами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum означає «Море Пари». Джованні Баттіста Річчолі опублікував назву 1651 року на місячній карті Франческо Грімальді. Вона належить до тієї ж погодної лексики, що й моря хмар і дощів. Це ім’я збереглося з доби, коли астрономи складали карти за телескопічними спостереженнями, за століття до докладного вивчення поверхні космічними апаратами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum意为“水汽之海”。乔瓦尼巴蒂斯塔里乔利在1651年，于弗朗切斯科格里马尔迪绘制的月图上发表了这个名字。它与云海、雨海同属天气词汇。这个名字诞生于天文学家通过望远镜绘制月图的时代，距离探测器能够近看月面还有几百年。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum意為「水汽之海」。喬瓦尼巴蒂斯塔里喬利在1651年，於弗朗切斯科格里馬爾迪繪製的月圖上發表了這個名字。它與雲海、雨海同屬天氣詞彙。這個名字誕生於天文學家透過望遠鏡繪製月圖的時代，距離探測器能夠近看月面還有幾百年。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Vaporum意為「水汽之海」。喬瓦尼巴蒂斯塔里喬利在1651年，於弗朗切斯科格里馬爾迪繪製的月圖上發表了這個名字。它與雲海、雨海同屬天氣詞彙。這個名字誕生於天文學家通過望遠鏡繪製月圖的時代，距離探測器能夠近看月面還有幾百年。"
          }
        }
      }
    },
    "atlas.feature.3694.observation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرب مركز الوجه القريب، يقع بحر الأبخرة جنوب غرب بحر الصفاء وجنوب الأبينيني. استخدم هذه المعالم الأكبر لتحديد البقعة الداكنة الصغيرة التي تحيط بها تضاريس أكثر سطوعًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahe der Mitte der Mondvorderseite liegt Vaporum südwestlich von Serenitatis und südlich der Apenninen. Diese größeren Orientierungspunkte helfen, die kleine dunkle Fläche inmitten helleren Geländes zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Near the center of the near side, Vaporum lies southwest of Serenitatis and south of the Apennines. Use those larger landmarks to locate this small dark patch enclosed by brighter terrain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca del centro de la cara visible, Vaporum se encuentra al suroeste de Serenitatis y al sur de los Apeninos. Usa esas referencias mayores para localizar esta pequeña mancha oscura rodeada de terreno más claro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca del centro de la cara visible, Vaporum se encuentra al suroeste de Serenitatis y al sur de los Apeninos. Usa esas referencias mayores para localizar esta pequeña mancha oscura rodeada de terreno más claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Près du centre de la face visible, Vaporum se trouve au sud-ouest de Serenitatis et au sud des Apennins. Ces grands repères permettent de localiser cette petite tache sombre entourée de terrains plus clairs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蒸気の海は月の表側の中央付近、晴れの海の南西、アペニン山脈の南にあります。周囲を明るい地形に囲まれた小さな暗部なので、大きな目印を手がかりに探してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perto do centro da face da Lua voltada para a Terra, o Mar dos Vapores fica a sudoeste do Mar da Serenidade e ao sul dos Apeninos. Use essas referências maiores para localizar essa pequena mancha escura cercada por terrenos mais claros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perto do centro da face da Lua voltada para a Terra, o Mar dos Vapores fica a sudoeste do Mar da Serenidade e ao sul dos Apeninos. Use essas referências maiores para localizar essa pequena mancha escura cercada por terrenos mais claros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Море Паров находится почти в центре видимой стороны, к юго-западу от Моря Ясности и к югу от Апеннин. Эти крупные ориентиры помогут найти маленькое тёмное пятно, окружённое более светлым рельефом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Море Пари лежить поблизу центру видимого боку, на південний захід від Моря Ясності й на південь від Апеннін. Ці більші орієнтири допоможуть знайти невелику темну пляму, оточену світлішим рельєфом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽海靠近月球正面中央，在澄海西南方、亚平宁山脉以南。借助这些更大的地标，可以找到这块被亮色地形包围的小暗区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽海靠近月球正面中央，在澄海西南方、亞平寧山脈以南。藉助這些更大的地標，可以找到這塊被亮色地形包圍的小暗區。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽海靠近月球正面中央，在澄海西南方、亞平寧山脈以南。藉助這些更大的地標，可以找到這塊被亮色地形包圍的小暗區。"
          }
        }
      }
    },
    "atlas.feature.3694.story" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد قبة بركانية في الجزء الشمالي من هذا البحر الذي يبدو مسطحًا. صوّرها LRO من زوايا مختلفة لإنتاج رؤية مجسّمة. تكشف مشاهدة السطح نفسه من زاويتين شكل القبة، وتضيف إحساسًا بالارتفاع إلى النمط المألوف من الضوء والظلال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im nördlichen Teil des scheinbar flachen Meers liegt ein Vulkandom. LRO fotografierte ihn aus verschiedenen Blickwinkeln, um eine Stereoansicht zu erstellen. Zwei Ansichten desselben Geländes machen die Form des Doms erkennbar und geben dem vertrauten Muster aus Hell und Dunkel räumliche Tiefe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The apparently flat sea has a volcanic dome in its northern part. LRO photographed it from different viewpoints to produce a stereo view. Seeing the same ground from two angles reveals the dome’s shape, adding a sense of height to the familiar pattern of light and dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mar, aparentemente llano, tiene un domo volcánico en su zona norte. LRO lo fotografió desde distintos puntos de vista para crear una imagen estereoscópica. Ver el mismo terreno desde dos ángulos revela la forma del domo y añade una sensación de altura al conocido patrón de claros y oscuros."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mar, aparentemente llano, tiene un domo volcánico en su zona norte. LRO lo fotografió desde distintos puntos de vista para crear una imagen estereoscópica. Ver el mismo terreno desde dos ángulos revela la forma del domo y añade una sensación de altura al conocido patrón de claros y oscuros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette mer apparemment plane possède un dôme volcanique dans sa partie nord. LRO l’a photographié de plusieurs points de vue pour créer une image stéréoscopique. Voir le même terrain sous deux angles révèle la forme du dôme et ajoute du relief au motif familier des zones claires et sombres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一見平らな海の北部には、火山性のドームがあります。LROは異なる位置から撮影して、立体視できる画像を作りました。同じ地面を二つの角度から見ることでドームの形が分かり、見慣れた明暗の模様に高さの情報が加わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mar aparentemente plano tem um domo vulcânico na parte norte. A LRO o fotografou de diferentes pontos de vista para produzir uma imagem estereoscópica. Ver o mesmo terreno de dois ângulos revela a forma do domo, acrescentando uma noção de altura ao conhecido padrão de claro e escuro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mar aparentemente plano tem um domo vulcânico na parte norte. A LRO fotografou-o de diferentes pontos de vista para produzir uma imagem estereoscópica. Observar o mesmo terreno de dois ângulos revela a forma do domo e acrescenta uma noção de altura ao conhecido padrão de claro e escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В северной части кажущегося плоским моря есть вулканический купол. LRO снял его с разных точек, чтобы получить стереоизображение. Два ракурса одной поверхности раскрывают форму купола и добавляют высоту к привычному рисунку светлых и тёмных пятен."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У північній частині на вигляд рівного моря є вулканічний купол. LRO сфотографував його з різних точок для створення стереозображення. Два ракурси тієї самої поверхні розкривають форму купола й додають відчуття висоти до звичного малюнка світлих і темних плям."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看似平坦的汽海，北部其实有一座火山穹丘。月球勘测轨道飞行器从不同视角拍摄它，制作了立体影像。从两个角度看同一片地面，便能显出穹丘的形状，让熟悉的明暗图案多出高度的层次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看似平坦的汽海，北部其實有一座火山穹丘。月球勘測軌道飛行器從不同視角拍攝它，製作了立體影像。從兩個角度看同一片地面，就能顯出穹丘的形狀，讓熟悉的明暗圖案多出高度的層次。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看似平坦的汽海，北部其實有一座火山穹丘。月球勘測軌道飛行器從不同角度拍攝它，製成立體影像。從兩個角度看同一片地面，便能顯出穹丘的形狀，讓熟悉的明暗圖案多了高度的層次。"
          }
        }
      }
    },
