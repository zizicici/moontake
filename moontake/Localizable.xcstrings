    "atlas.feature_reference.accessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صورة مرجعية من المدار لمعلم %@، والشمال في الأعلى. تختلف الإضاءة عن صورتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referenzbild von %@ aus der Mondumlaufbahn, Norden oben. Die Beleuchtung unterscheidet sich von deinem Foto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbital reference image of %@, north up. Lighting differs from your photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagen orbital de referencia de %@, con el norte arriba. La iluminación difiere de la de tu foto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagen orbital de referencia de %@, con el norte arriba. La iluminación difiere de la de tu foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image orbitale de référence de %@, nord en haut. L’éclairage diffère de celui de votre photo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を月周回軌道から撮影した参考画像。北が上です。光の当たり方は写真と異なります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagem orbital de referência de %@, com o norte para cima. A iluminação difere da sua foto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagem orbital de referência de %@, com o norte para cima. A iluminação é diferente da sua fotografia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орбитальный снимок объекта %@, север сверху. Освещение отличается от вашего снимка."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орбітальний знімок об’єкта %@, північ угорі. Освітлення відрізняється від вашого фото."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
