    "moon_finder.sensors.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الزوايا أعلاه مع بوصلة. يُقاس السمت مع عقارب الساعة من الشمال الحقيقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie die Winkel oben mit einem Kompass. Der Azimut zählt im Uhrzeigersinn ab geografisch Nord."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the angles above with a compass. Azimuth is measured clockwise from true north."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los ángulos de arriba con una brújula. El acimut se mide en sentido horario desde el norte geográfico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los ángulos de arriba con una brújula. El acimut se mide en sentido horario desde el norte geográfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les angles ci-dessus avec une boussole. L’azimut se mesure dans le sens horaire depuis le nord géographique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上の角度とコンパスを参考にしてください。方位角は真北から時計回りです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use os ângulos acima com uma bússola. O azimute é medido no sentido horário a partir do norte geográfico."
          }
        },
        "pt-PT" : {
