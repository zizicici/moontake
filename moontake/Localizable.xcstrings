    "album.clear.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع الصور من ألبوم التطبيق، لكن الصور المحفوظة في مكتبة النظام لن يتم حذفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Fotos aus dem App-Album gelöscht, aber Fotos, die in der Systemmediathek gespeichert wurden, werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete all photos from the app album, but photos saved to the system library will not be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todas las fotos del álbum de la app, pero las fotos guardadas en la biblioteca del sistema no se eliminarán."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todas las fotos del álbum de la app, pero las fotos guardadas en la biblioteca del sistema no se eliminarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera toutes les photos de l’album de l’app, mais les photos enregistrées dans la photothèque du système ne seront pas supprimées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりアプリ内アルバムの写真はすべて削除されますが、システムライブラリに保存された写真は削除されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá todas as fotos do álbum do app, mas as fotos salvas na biblioteca do sistema não serão excluídas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto eliminará todas as fotos do álbum da app, mas as fotos guardadas na biblioteca do sistema não serão eliminadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все фотографии из альбома приложения, но фотографии, сохраненные в системной библиотеке, удалены не будут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить усі фотографії з альбому застосунку, але фотографії, збережені в системній бібліотеці, не буде видалено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清空 App 内相册中的所有照片，但已经保存到系统图库的照片不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清空 App 內相簿中的所有照片，但已經儲存到系統圖庫的照片不會被刪除。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清空 App 內相簿中的所有照片，但已經儲存到系統圖庫的照片不會被刪除。"
          }
        }
      }
    },
