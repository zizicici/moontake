    "We extend our heartfelt appreciation to all developers of open-source projects." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir möchten allen Entwicklern von Open-Source-Projekten unseren herzlichsten Dank aussprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extendemos nuestro sincero agradecimiento a todos los desarrolladores de proyectos de código abierto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extendemos nuestro sincero agradecimiento a todos los desarrolladores de proyectos de código abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous exprimons notre sincère gratitude à tous les développeurs de projets open source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープンソースプロジェクトのすべての開発者に心から感謝申し上げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estendemos nosso sincero agradecimento a todos os desenvolvedores de projetos de código aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estendemos nosso sincero agradecimento a todos os desenvolvedores de projetos de código aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы выражаем искреннюю благодарность всем разработчикам проектов с открытым исходным кодом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми щиро вдячні всім розробникам проектів з відкритим вихідним кодом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此向所有开源项目开发者表达感谢与敬意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此向所有開源項目開發者表達感謝與敬意。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
