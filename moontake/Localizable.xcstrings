    "atlas.feature.4003.naming" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمدت الألب القمرية اسمها من جبال الألب على الأرض. بقي الاسم من كتاب «وصف القمر» لهيفيليوس عام 1647، الذي ملأ الخريطة القمرية بأسماء جغرافية أرضية مألوفة. استُبدل معظم ذلك النظام، لكن الألب بقيت جزءًا صغيرًا من طريقة مبكرة لرسم خريطة عالم آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mondalpen sind nach den Alpen auf der Erde benannt. Der Name stammt aus Hevelius’ Selenographia von 1647, die vertraute irdische Geografie auf die Mondkarte übertrug. Die meisten dieser Namen wurden ersetzt. Die Alpen blieben als kleines Zeugnis dieser frühen Art erhalten, eine andere Welt zu kartieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lunar Alps take their name from the Alps on Earth. The name survives from Hevelius’s Selenographia of 1647, which filled the lunar map with familiar terrestrial geography. Most of that scheme was replaced, but Alps remained as a small part of an early way of mapping another world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Alpes lunares toman su nombre de los Alpes terrestres. Se conserva desde la Selenographia de Hevelius, de 1647, que llenó el mapa lunar de referencias geográficas conocidas de la Tierra. La mayor parte de ese sistema fue sustituido, pero los Alpes permanecieron como un pequeño vestigio de una forma temprana de cartografiar otro mundo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Alpes lunares toman su nombre de los Alpes terrestres. Se conserva desde la Selenographia de Hevelius, de 1647, que llenó el mapa lunar de referencias geográficas conocidas de la Tierra. La mayor parte de ese sistema fue sustituido, pero los Alpes permanecieron como un pequeño vestigio de una forma temprana de cartografiar otro mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Alpes lunaires portent le nom des Alpes terrestres. Il vient de la Selenographia d’Hevelius, publiée en 1647, qui remplissait la carte lunaire de noms géographiques familiers. La plupart ont été remplacés, mais les Alpes subsistent comme une petite trace de cette première manière de cartographier un autre monde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月のアルプス山脈は、地球のアルプスにちなんでいます。ヘヴェリウスの1647年の『月面学』に由来する名前で、彼は身近な地球の地理を使って月の地図を描きました。その命名の大半は後に置き換えられましたが、アルプスは別の世界を描く初期の試みの一部として残りました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Alpes Lunares receberam o nome dos Alpes da Terra. O nome vem da Selenographia, de Hevelius, publicada em 1647, que preencheu o mapa da Lua com referências à geografia terrestre. A maior parte desse sistema foi substituída, mas os Alpes permaneceram como um pequeno vestígio de uma antiga maneira de mapear outro mundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Alpes Lunares receberam o nome dos Alpes da Terra. O nome vem da Selenographia, de Hevelius, publicada em 1647, que preencheu o mapa da Lua com referências à geografia terrestre. A maior parte desse sistema foi substituída, mas os Alpes permaneceram como um pequeno vestígio de uma antiga maneira de mapear outro mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лунные Альпы названы в честь земных Альп. Название сохранилось со времён «Селенографии» Гевелия 1647 года, наполнявшей лунную карту знакомыми земными именами. Большую часть этой системы позже заменили, но Альпы остались небольшим наследием раннего способа картографировать другой мир."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місячні Альпи отримали назву від Альп на Землі. Вона збереглася із «Селенографії» Гевелія 1647 року, що наповнила місячну карту знайомими земними назвами. Більшість тієї системи згодом замінили, але Альпи лишилися невеликою спадщиною раннього способу картографувати інший світ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月球上的阿尔卑斯山脉，借用了地球上阿尔卑斯山的名字。它沿用自赫维留1647年的《月面学》；那套命名大量采用人们熟悉的地球地理名称。大部分名称后来被替换，阿尔卑斯却留了下来，保留着早期描绘另一个世界的一种思路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月球上的阿爾卑斯山脈，借用了地球上阿爾卑斯山的名字。它沿用自赫維留1647年的《月面學》；那套命名大量採用人們熟悉的地球地理名稱。大部分名稱後來被替換，阿爾卑斯卻留了下來，保留著早期描繪另一個世界的一種思路。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月球上的阿爾卑斯山脈，借用了地球上阿爾卑斯山的名字。它沿用自赫維留1647年的《月面學》；那套命名大量採用人們熟悉的地球地理名稱。大部分名稱後來被替換，阿爾卑斯卻留了下來，保留着早期描繪另一個世界的一種思路。"
          }
        }
      }
    },
    "atlas.feature.4003.observation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقع الألب القمرية على الحافة الشمالية الشرقية لبحر الأمطار، قرب أفلاطون. تحدّ تضاريسها الساطعة الوعرة السهل الداكن الأملس، وتساعد الظلال عند انخفاض الشمس على إظهار حدودها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mondalpen liegen am nordöstlichen Rand von Imbrium, nahe Plato. Ihr helles, zerklüftetes Gelände grenzt an die glatte dunkle Ebene. Schatten bei tief stehender Sonne helfen, den Umriss zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lunar Alps stand on Imbrium’s northeastern edge, near Plato. Their bright, rough terrain borders the smooth dark plain, with low-sun shadows helping reveal the outline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Alpes lunares se encuentran en el borde noreste de Imbrium, cerca de Platón. Su terreno claro y escarpado limita con la llanura oscura y lisa. Las sombras del Sol bajo ayudan a distinguir su contorno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Alpes lunares se encuentran en el borde noreste de Imbrium, cerca de Platón. Su terreno claro y escarpado limita con la llanura oscura y lisa. Las sombras del Sol bajo ayudan a distinguir su contorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Alpes lunaires se dressent au bord nord-est d’Imbrium, près de Platon. Leurs reliefs clairs et accidentés côtoient la plaine sombre et lisse. Les ombres d’un Soleil bas aident à en révéler les contours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルプス山脈は雨の海の北東の縁、プラトンの近くにあります。明るく険しい山地が滑らかで暗い平原に接し、太陽が低いときの影が輪郭を浮かび上がらせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Alpes Lunares ficam na borda nordeste do Mar das Chuvas, perto de Platão. O terreno claro e acidentado margeia a planície escura e lisa. As sombras sob luz solar rasante ajudam a revelar seu contorno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Alpes Lunares ficam na borda nordeste do Mar das Chuvas, perto de Platão. O terreno claro e acidentado ladeia a planície escura e lisa. As sombras sob luz solar rasante ajudam a revelar o seu contorno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лунные Альпы стоят на северо-восточном краю Моря Дождей, рядом с Платоном. Их светлый пересечённый рельеф граничит с гладкой тёмной равниной, а тени при низком Солнце помогают увидеть очертания."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місячні Альпи стоять на північно-східному краї Моря Дощів, поблизу Платона. Їхній світлий, нерівний рельєф межує з гладкою темною рівниною, а тіні за низького Сонця допомагають побачити обриси."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿尔卑斯山脉位于雨海东北缘，靠近柏拉图环形山。明亮崎岖的山地与平滑暗色平原相接，低角度阳光下的阴影有助于显出轮廓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿爾卑斯山脈位於雨海東北緣，靠近柏拉圖環形山。明亮崎嶇的山地與平滑暗色平原相接，低角度陽光下的陰影有助於顯出輪廓。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿爾卑斯山脈位於雨海東北緣，靠近柏拉圖環形山。明亮崎嶇的山地與平滑暗色平原相接，低角度陽光下的陰影有助於顯出輪廓。"
          }
        }
      }
    },
    "atlas.feature.4003.story" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي وادي الألب على قناة ثانية أضيق بكثير: أخدود متعرج يتجاوز طوله 150 كيلومترًا في أرضيته التي غمرتها الحمم. تُظهر الصور المدارية مواضع تجمعت فيها الحمم خلف ممر ضيق، ثم اخترقته، تاركة سجلًا بركانيًا داخل الوادي الأكبر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Alpental liegt ein zweiter, viel schmalerer Kanal: eine über 150 Kilometer lange gewundene Rille im einst von Lava überfluteten Talboden. Aufnahmen aus der Umlaufbahn zeigen Stellen, an denen sich Lava vor einer Engstelle staute und sie dann durchbrach. So blieb im großen Tal eine weitere Spur vulkanischer Aktivität erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Alpine Valley contains a second, much narrower channel: a sinuous rille more than 150 kilometers long within its lava-flooded floor. Orbital images show places where lava ponded behind a constriction and then breached it, leaving a volcanic record inside the larger valley."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valle de los Alpes contiene un segundo canal, mucho más estrecho: un surco sinuoso de más de 150 kilómetros en su fondo inundado por lava. Las imágenes orbitales muestran lugares donde la lava se acumuló tras un estrechamiento y acabó abriendo paso a través de él. Así dejó un registro volcánico dentro del valle mayor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valle de los Alpes contiene un segundo canal, mucho más estrecho: un surco sinuoso de más de 150 kilómetros en su fondo inundado por lava. Las imágenes orbitales muestran lugares donde la lava se acumuló tras un estrechamiento y acabó abriendo paso a través de él. Así dejó un registro volcánico dentro del valle mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vallée des Alpes contient un second chenal, bien plus étroit : une rainure sinueuse de plus de 150 kilomètres dans son fond autrefois inondé de lave. Les images orbitales montrent des endroits où la lave s’est accumulée derrière un passage resserré avant d’y ouvrir une brèche. La grande vallée conserve ainsi une autre trace du volcanisme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルプス谷の内部には、さらに細い蛇行する溝があります。溶岩で覆われた谷底に、150キロメートル以上延びる月の溝です。軌道画像には、狭い場所で溶岩がせき止められてたまり、やがてそこを突破した跡が写っています。大きな谷の中に、火山活動の記録が残されているのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vale Alpino contém um segundo canal, muito mais estreito: um sulco sinuoso com mais de 150 quilômetros de comprimento no fundo coberto por lava. Imagens orbitais mostram lugares onde a lava se acumulou atrás de um estreitamento e depois o rompeu, deixando um registro vulcânico dentro do vale maior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vale Alpino contém um segundo canal, muito mais estreito: um sulco sinuoso com mais de 150 quilómetros de comprimento no fundo coberto por lava. Imagens orbitais mostram lugares onde a lava se acumulou atrás de um estreitamento e depois o rompeu, deixando um registo vulcânico dentro do vale maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри Альпийской долины есть ещё одно, гораздо более узкое русло: извилистая борозда длиной свыше 150 километров на залитом лавой дне. Орбитальные снимки показывают места, где лава скапливалась перед сужением, а затем прорывалась через него. В большой долине сохранилась запись вулканических событий."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усередині Альпійської долини є друге, набагато вужче русло: звивиста борозна понад 150 кілометрів завдовжки на залитому лавою дні. Орбітальні знімки показують місця, де лава накопичувалася перед звуженням, а потім проривала його. Усередині великої долини зберігся запис вулканічних подій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿尔卑斯谷内还有第二条窄得多的沟槽：被熔岩淹没的谷底上，一条弯曲月溪延伸超过150公里。轨道图像显示，有些地方的熔岩曾在狭窄处受阻、积聚，随后冲破阻隔，在大峡谷中留下火山活动的记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿爾卑斯谷內還有第二條窄得多的溝槽：被熔岩淹沒的谷底上，一條彎曲月溪延伸超過150公里。軌道影像顯示，有些地方的熔岩曾在狹窄處受阻、積聚，隨後衝破阻隔，在大峽谷中留下火山活動的記錄。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿爾卑斯谷內還有第二條窄得多的溝槽：被熔岩淹沒的谷底上，一條彎曲月溪延伸超過150公里。軌道影像顯示，有些地方的熔岩曾在狹窄處受阻、積聚，隨後衝破阻隔，在大峽谷中留下火山活動的記錄。"
          }
        }
      }
    },
