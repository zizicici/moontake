    "atlas.feature.3678.naming" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعني Mare Imbrium «بحر الأمطار». سمّاه الفلكي الإيطالي جيوفاني باتيستا ريتشيولي عام 1651 على خريطة رسمها فرانشيسكو غريمالدي. تنتمي الأمطار والسحب والعواصف إلى منظومة أسماء تأثرت بالاعتقاد القديم بأن القمر يؤثر في طقس الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium bedeutet „Meer der Regenschauer“. Der italienische Astronom Giovanni Battista Riccioli benannte es 1651 auf einer Karte von Francesco Grimaldi. Regen, Wolken und Stürme gehören zu einer Namensgebung, die von der alten Vorstellung geprägt war, der Mond beeinflusse das Wetter auf der Erde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium means “Sea of Showers.” The Italian astronomer Giovanni Battista Riccioli named it in 1651 on a map drawn by Francesco Grimaldi. Rain, clouds and storms belong to a naming scheme shaped by the old belief that the Moon influenced weather on Earth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium significa «mar de las Lluvias». El astrónomo italiano Giovanni Battista Riccioli le dio nombre en 1651 en un mapa dibujado por Francesco Grimaldi. Lluvia, nubes y tormentas forman parte de una nomenclatura marcada por la antigua creencia de que la Luna influía en el tiempo de la Tierra."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium significa «mar de las Lluvias». El astrónomo italiano Giovanni Battista Riccioli le dio nombre en 1651 en un mapa dibujado por Francesco Grimaldi. Lluvia, nubes y tormentas forman parte de una nomenclatura marcada por la antigua creencia de que la Luna influía en el tiempo de la Tierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium signifie « mer des Pluies ». L’astronome italien Giovanni Battista Riccioli l’a nommée en 1651 sur une carte dessinée par Francesco Grimaldi. Pluie, nuages et tempêtes appartiennent à un ensemble de noms inspiré de l’ancienne croyance selon laquelle la Lune influençait le temps sur Terre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbriumは「雨の海」を意味します。イタリアの天文学者ジョヴァンニ バッティスタ リッチョーリが1651年、フランチェスコ グリマルディの描いた月面図で名付けました。雨、雲、嵐といった名前には、月が地球の天候に影響するという古い考えが反映されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium significa “Mar das Chuvas”. O astrônomo italiano Giovanni Battista Riccioli deu esse nome em 1651, em um mapa desenhado por Francesco Grimaldi. Chuva, nuvens e tempestades fazem parte de um sistema de nomes influenciado pela antiga crença de que a Lua afetava o tempo na Terra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium significa “Mar das Chuvas”. O astrónomo italiano Giovanni Battista Riccioli deu esse nome em 1651, num mapa desenhado por Francesco Grimaldi. Chuva, nuvens e tempestades fazem parte de um sistema de nomes influenciado pela antiga crença de que a Lua afetava o tempo na Terra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium означает «Море Дождей». Итальянский астроном Джованни Баттиста Риччоли назвал его в 1651 году на карте, нарисованной Франческо Гримальди. Дожди, облака и бури относятся к системе имён, на которую повлияло старое убеждение, что Луна управляет земной погодой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium означає «Море Дощів». Італійський астроном Джованні Баттіста Річчолі назвав його 1651 року на карті, намальованій Франческо Грімальді. Дощі, хмари й бурі належать до системи назв, сформованої під впливом давньої віри в те, що Місяць впливає на земну погоду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium意为“阵雨之海”。意大利天文学家乔瓦尼巴蒂斯塔里乔利在1651年，为弗朗切斯科格里马尔迪绘制的月图命名时选用了它。雨、云与风暴这组名称，受到月亮能影响地球天气这一古老观念的启发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium意為「陣雨之海」。義大利天文學家喬瓦尼巴蒂斯塔里喬利在1651年，為弗朗切斯科格里馬爾迪繪製的月圖命名時選用了它。雨、雲與風暴這組名稱，受到月亮能影響地球天氣這一古老觀念的啟發。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mare Imbrium意為「陣雨之海」。意大利天文學家喬瓦尼巴蒂斯塔里喬利在1651年，為弗朗切斯科格里馬爾迪繪製的月圖命名時選用了它。雨、雲與風暴這組名稱，受到月亮能影響地球天氣這一古老觀念的啓發。"
          }
        }
      }
    },
    "atlas.feature.3678.observation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحر الأمطار بقعة داكنة واسعة شبه دائرية، تحدّها جبال الأبينيني الساطعة من الجنوب الشرقي. غالبًا ما يسهل التعرف على هذا الحد المقوّس أكثر من الفوهات الصغيرة داخل البحر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbrium ist eine große, annähernd runde dunkle Fläche, die im Südosten von den hellen Apenninen begrenzt wird. Dieser gebogene Rand ist oft leichter zu erkennen als die kleinen Krater im Inneren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbrium is a broad, roughly circular dark patch bordered by the bright Apennine Mountains to the southeast. That curved boundary is often easier to recognize than the small craters within it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbrium es una gran mancha oscura, más o menos circular, bordeada al sureste por los brillantes montes Apeninos. Ese límite curvo suele ser más fácil de reconocer que los pequeños cráteres del interior."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbrium es una gran mancha oscura, más o menos circular, bordeada al sureste por los brillantes montes Apeninos. Ese límite curvo suele ser más fácil de reconocer que los pequeños cráteres del interior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbrium est une vaste tache sombre à peu près circulaire, bordée au sud-est par les Apennins clairs. Cette limite courbe est souvent plus facile à reconnaître que les petits cratères à l’intérieur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨の海は広くほぼ円形の暗部で、南東の縁を明るいアペニン山脈が囲んでいます。海の中の小さなクレーターを探すより、この弧状の縁を見つけるほうが簡単なことがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mar das Chuvas é uma mancha escura ampla, quase circular, delimitada pelos claros Montes Apeninos a sudeste. Essa fronteira curva costuma ser mais fácil de reconhecer do que as pequenas crateras em seu interior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mar das Chuvas é uma mancha escura ampla, quase circular, delimitada pelos claros Montes Apeninos a sudeste. Essa fronteira curva costuma ser mais fácil de reconhecer do que as pequenas crateras no seu interior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Море Дождей — широкое, почти круглое тёмное пятно, обрамлённое с юго-востока светлыми Апеннинами. Эту дугообразную границу часто легче узнать, чем небольшие кратеры внутри моря."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Море Дощів — велика, майже кругла темна пляма, яку з південного сходу обрамляють світлі Апенніни. Цю дугоподібну межу часто легше впізнати, ніж маленькі кратери всередині моря."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海是一大片近圆形暗区，东南缘围绕着明亮的亚平宁山脉。那道弧形边界通常比海中的小环形山更容易辨认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海是一大片近圓形暗區，東南緣圍繞著明亮的亞平寧山脈。那道弧形邊界通常比海中的小環形山更容易辨認。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海是一大片近圓形暗區，東南緣圍繞着明亮的亞平寧山脈。那道弧形邊界通常比海中的小環形山更容易辨認。"
          }
        }
      }
    },
    "atlas.feature.3678.story" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض القمم المنعزلة داخل بحر الأمطار بقايا حلقة جبلية مطمورة. ما زال جبل بيتون يرتفع نحو 2,300 متر فوق السهل. كان جزءًا من الحلقة الداخلية للحوض، ثم غمرت الثورات اللاحقة معظمها. تكشف القمة الباقية عن مشهد أقدم من الحمم المحيطة بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige einzelne Berge in Imbrium sind Reste eines verschütteten Gebirgsrings. Mons Piton ragt noch etwa 2.300 Meter über die Ebene. Einst gehörte er zum inneren Ring des Beckens; spätere Ausbrüche überfluteten den Großteil dieses Rings. Der verbliebene Gipfel zeigt eine Landschaft, die älter ist als die umgebende Lava."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some isolated peaks within Imbrium are remnants of a buried mountain ring. Mons Piton still rises about 2,300 meters above the plain. It once belonged to the basin’s inner ring; later eruptions submerged most of that ring. The surviving summit reveals a landscape older than the surrounding lava."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos picos aislados de Imbrium son restos de un anillo montañoso sepultado. El monte Piton todavía se alza unos 2300 metros sobre la llanura. Perteneció al anillo interior de la cuenca; erupciones posteriores sumergieron gran parte de él. La cumbre que queda a la vista revela un paisaje anterior a la lava circundante."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos picos aislados de Imbrium son restos de un anillo montañoso sepultado. El monte Piton todavía se alza unos 2300 metros sobre la llanura. Perteneció al anillo interior de la cuenca; erupciones posteriores sumergieron gran parte de él. La cumbre que queda a la vista revela un paisaje anterior a la lava circundante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains sommets isolés d’Imbrium sont les vestiges d’un anneau montagneux enfoui. Le mont Piton s’élève encore d’environ 2 300 mètres au-dessus de la plaine. Il appartenait à l’anneau intérieur du bassin, dont des éruptions ultérieures ont submergé la plus grande partie. Le sommet préservé révèle un paysage plus ancien que les laves environnantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨の海に孤立する山の一部は、埋もれた環状山地の名残です。ピトン山は今も平原から約2,300メートルそびえています。かつては盆地の内側の環を形作っていましたが、後の噴火でその大半が埋まりました。残った頂は、周囲の溶岩より古い風景を伝えています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns picos isolados no Mar das Chuvas são restos de um anel de montanhas soterrado. O monte Piton ainda se eleva cerca de 2.300 metros acima da planície. Ele fazia parte do anel interno da bacia; erupções posteriores cobriram a maior parte desse anel. O cume que permaneceu exposto revela uma paisagem mais antiga que a lava ao redor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns picos isolados no Mar das Chuvas são restos de um anel de montanhas soterrado. O monte Piton ainda se eleva cerca de 2 300 metros acima da planície. Ele fazia parte do anel interno da bacia; erupções posteriores cobriram a maior parte desse anel. O cume que permaneceu exposto revela uma paisagem mais antiga que a lava ao redor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые одинокие вершины в Море Дождей — остатки погребённого горного кольца. Гора Питон до сих пор возвышается над равниной примерно на 2 300 метров. Когда-то она входила во внутреннее кольцо бассейна, большую часть которого затопили последующие извержения. Уцелевшая вершина показывает ландшафт, более древний, чем окружающая лава."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі поодинокі вершини в Морі Дощів — рештки похованого гірського кільця. Гора Пітон досі здіймається над рівниною приблизно на 2 300 метрів. Колись вона належала до внутрішнього кільця басейну, більшу частину якого затопили пізніші виверження. Вціліла вершина відкриває краєвид, давніший за навколишню лаву."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海中一些孤立山峰，是被掩埋的环形山脉留下的部分。皮通山至今仍高出平原约2,300米。它曾是盆地内环的一部分，后来的喷发淹没了内环的大部分。露出的峰顶揭示了一片比周围熔岩更古老的地形。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海中一些孤立山峰，是被掩埋的環形山脈留下的部分。皮通山至今仍高出平原約2,300公尺。它曾是盆地內環的一部分，後來的噴發淹沒了內環的大部分。露出的峰頂揭示了一片比周圍熔岩更古老的地形。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨海中一些孤立山峯，是被掩埋的環形山脈留下的部分。皮通山至今仍高出平原約2,300米。它曾是盆地內環的一部分，後來的噴發淹沒了內環的大部分。露出的峯頂揭示了一片比周圍熔岩更古老的地形。"
          }
        }
      }
    },
